@Composable
private fun SophisticatedVoiceVisual(
    profile: VoiceProfile,
    listening: Boolean,
    speaking: Boolean,
    muted: Boolean
) {
    val transition = rememberInfiniteTransition(label = "voice_visual")
    val pulse by transition.animateFloat(
        initialValue = 0.92f,
        targetValue = if (speaking) 1.13f else 1.04f,
        animationSpec = infiniteRepeatable(
            animation = tween(
                durationMillis = if (speaking) 700 else 1300,
                easing = FastOutSlowInEasing
            ),
            repeatMode = RepeatMode.Reverse
        ),
        label = "voice_pulse"
    )
    val rotation by transition.animateFloat(
        initialValue = 0f,
        targetValue = 360f,
        animationSpec = infiniteRepeatable(
            animation = tween(9000, easing = LinearEasing)
        ),
        label = "voice_rotation"
    )

    Box(
        modifier = Modifier.size(220.dp),
        contentAlignment = Alignment.Center
    ) {
        Box(
            modifier = Modifier
                .size(188.dp)
                .rotate(rotation)
                .background(
                    profile.accent.copy(alpha = if (muted) 0.04f else 0.09f),
                    RoundedCornerShape(64.dp)
                )
        )

        Box(
            modifier = Modifier
                .size(142.dp)
                .rotate(-rotation * 0.65f)
                .background(
                    profile.accent.copy(alpha = if (muted) 0.06f else 0.15f),
                    RoundedCornerShape(48.dp)
                )
        )

        Box(
            modifier = Modifier
                .size(92.dp)
                .graphicsLayer {
                    scaleX = pulse
                    scaleY = pulse
                    alpha = if (muted) 0.45f else 1f
                }
                .background(
                    profile.accent.copy(alpha = 0.85f),
                    RoundedCornerShape(32.dp)
                ),
            contentAlignment = Alignment.Center
        ) {
            Text(
                if (muted) "×" else "•",
                color = Color(0xFF080A10),
                fontSize = 34.sp,
                fontWeight = FontWeight.Bold
            )
        }

        if (listening) {
            Text(
                "•••",
                modifier = Modifier
                    .align(Alignment.BottomCenter)
                    .padding(bottom = 7.dp),
                color = Color.White.copy(alpha = 0.8f),
                fontSize = 20.sp,
                letterSpacing = 4.sp
            )
        }
    }
}

