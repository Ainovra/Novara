    fun startDictationListening() {
        if (speechRecognizer == null || voiceModeActive || loading) return
        if (ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {
            microphonePermissionLauncher.launch(Manifest.permission.RECORD_AUDIO)
            return
        }
        voiceToTextActive = true
        val intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
            putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
            putExtra(RecognizerIntent.EXTRA_LANGUAGE, Locale.getDefault().toLanguageTag())
            putExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, true)
            putExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 1)
            putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_COMPLETE_SILENCE_LENGTH_MILLIS, 900L)
            putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_POSSIBLY_COMPLETE_SILENCE_LENGTH_MILLIS, 450L)
        }
        speechRecognizer.cancel()
        speechRecognizer.startListening(intent)
    }

    fun startVoiceListening() {
        if (!voiceModeActive || voiceMuted || speechRecognizer == null || loading) return

        if (
            ContextCompat.checkSelfPermission(
                context,
                Manifest.permission.RECORD_AUDIO
            ) != PackageManager.PERMISSION_GRANTED
        ) {
            microphonePermissionLauncher.launch(Manifest.permission.RECORD_AUDIO)
            return
        }

        voiceListening = true

        val intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
            putExtra(
                RecognizerIntent.EXTRA_LANGUAGE_MODEL,
                RecognizerIntent.LANGUAGE_MODEL_FREE_FORM
            )
            putExtra(
                RecognizerIntent.EXTRA_LANGUAGE,
                Locale.getDefault().toLanguageTag()
            )
            putExtra(
                RecognizerIntent.EXTRA_LANGUAGE_PREFERENCE,
                Locale.getDefault().toLanguageTag()
            )
            putExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, true)
            putExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 3)
            putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_COMPLETE_SILENCE_LENGTH_MILLIS, 650L)
            putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_POSSIBLY_COMPLETE_SILENCE_LENGTH_MILLIS, 350L)
            putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_MINIMUM_LENGTH_MILLIS, 250L)
        }

        speechRecognizer.startListening(intent)
    }

    fun startVoiceConversation() {
        if (!voiceEnabled) return

        voiceModeActive = true
        voiceModeFullScreen = true
        voiceMuted = false

        if (
            ContextCompat.checkSelfPermission(
                context,
                Manifest.permission.RECORD_AUDIO
            ) != PackageManager.PERMISSION_GRANTED
        ) {
            microphonePermissionLauncher.launch(Manifest.permission.RECORD_AUDIO)
        } else {
            startVoiceListening()
        }
    }

    fun stopVoiceConversation() {
        voiceModeActive = false
        voiceModeFullScreen = false
        voiceListening = false
        voiceSpeaking = false
        voiceMuted = false
        speechRecognizer?.cancel()
        stopNovaraTts()
    }

    fun sendVoiceText(text: String) {
        val clean = text.trim()
        if (clean.isBlank() || loading || !voiceModeActive) return
        input = clean
        send()
    }

    DisposableEffect(speechRecognizer) {
        if (speechRecognizer != null) {
            speechRecognizer.setRecognitionListener(object : RecognitionListener {
                override fun onReadyForSpeech(params: Bundle?) {
                    voiceListening = true
                }

                override fun onBeginningOfSpeech() {
                    voiceListening = true
                }

                override fun onRmsChanged(rmsdB: Float) = Unit
                override fun onBufferReceived(buffer: ByteArray?) = Unit

                override fun onEndOfSpeech() {
                    voiceListening = false
                }

                override fun onError(error: Int) {
                    voiceListening = false
                    if (voiceToTextActive) {
                        voiceToTextActive = false
                    } else if (voiceModeActive && !voiceMuted &&
                        error != SpeechRecognizer.ERROR_CLIENT &&
                        error != SpeechRecognizer.ERROR_RECOGNIZER_BUSY
                    ) {
                        startVoiceListening()
                    }
                }

                override fun onResults(results: Bundle?) {
                    voiceListening = false
                    val text = results
                        ?.getStringArrayList(
                            SpeechRecognizer.RESULTS_RECOGNITION
                        )
                        ?.firstOrNull()
                        ?.trim()

                    if (voiceToTextActive) {
                        voiceToTextActive = false
                        if (!text.isNullOrBlank()) input = text
                    } else if (!text.isNullOrBlank() && voiceModeActive && !voiceMuted) {
                        sendVoiceText(text)
                    } else if (voiceModeActive && !voiceMuted) {
                        startVoiceListening()
                    }
                }

                override fun onPartialResults(partialResults: Bundle?) {
                    val partial = partialResults
                        ?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION)
                        ?.firstOrNull()
                        ?.trim()

                    if (voiceToTextActive && !partial.isNullOrBlank()) {
                        input = partial
                    }
                    // Barge-in: if the user starts talking while Novara is speaking,
                    // immediately stop TTS instead of waiting for a full sentence.
                    if (voiceModeActive && voiceSpeaking && !partial.isNullOrBlank()) {
                        stopNovaraTts()
                        voiceSpeaking = false
                        voiceListening = true
                    }
                }
                override fun onEvent(eventType: Int, params: Bundle?) = Unit
            })
        }

        onDispose {
            speechRecognizer?.cancel()
            speechRecognizer?.destroy()
        }
    }

    LaunchedEffect(voiceStartRequested, voiceModeActive) {
        if (voiceStartRequested && voiceModeActive) {
            voiceStartRequested = false
            startVoiceListening()
        }
    }

    LaunchedEffect(dictationStartRequested) {
        if (dictationStartRequested) {
            dictationStartRequested = false
            startDictationListening()
        }
    }

    LaunchedEffect(voiceRestartTick) {
        if (voiceRestartTick > 0 && voiceModeActive && !voiceMuted) {
            startVoiceListening()
        }
    }

