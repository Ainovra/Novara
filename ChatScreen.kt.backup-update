                    voiceListening = false
                    speechRecognizer?.cancel()
                } else if (voiceModeActive && !voiceSpeaking) {
                    startVoiceListening()
                }
            },
            onVoiceChange = { selectVoiceProfile(it) },
            onClose = { stopVoiceConversation() }
        )
    }
}

