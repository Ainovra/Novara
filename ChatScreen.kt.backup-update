                            webSearch = it

                            if (it)
                                imageGen = false

                            NovaraSettings.set(
                                context,
                                "web_search",
                                webSearch
                            )

                            NovaraSettings.set(
                                context,
                                "image_gen",
                                imageGen
                            )
                        }
                    }

                    item {
                        SettingSwitch(
                            "Image generation",
                            imageGen
                        ) {
                            imageGen = it

                            if (it)
                                webSearch = false

                            NovaraSettings.set(
                                context,
                                "image_gen",
                                imageGen
                            )

                            NovaraSettings.set(
                                context,
                                "web_search",
                                webSearch
                            )
                        }
                    }

                    item {
                        SettingSwitch(
                            "Files & attachments",
                            filesEnabled
                        ) {
