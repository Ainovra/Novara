@OptIn(androidx.compose.material3.ExperimentalMaterial3Api::class)
@Composable
fun ChatScreen() {

    // NOVARA_REWARDED_AD_UI

    val scope = rememberCoroutineScope()

    val context = LocalContext.current
    val rewardedAdManager = remember(context) {
        RewardedAdManager.get(context)
    }
    val activity = context as? Activity
    var rewardMessage by remember { mutableStateOf<String?>(null) }
    var rewardBusy by remember { mutableStateOf(false) }
    var rewardAdCount by remember { mutableStateOf(0) }
    var showRewardPage by remember { mutableStateOf(false) }


    LaunchedEffect(Unit) {
        rewardedAdManager.preload()
    }

    fun watchAndEarn() {
        if (rewardBusy) return
        showRewardPage = true
    }

    fun startRewardAd() {
        val host = activity ?: return
        if (rewardBusy) return

        rewardBusy = true

        val shown = rewardedAdManager.show(
            activity = host,
            onRewardEarned = {
                scope.launch {
                    val completed = rewardAdCount + 1

                    // One unique ID for this successful rewarded-ad callback.
                    // The server stores it permanently for idempotency.
                    val claimId = UUID.randomUUID().toString()

                    when (val result = ApiClient.claimRewardedAd(claimId)) {
                        is ApiClient.ApiResult.Success -> {
                            rewardMessage = result.data.message

                            if (completed >= 3) {
                                rewardAdCount = 0
                                showRewardPage = false
                            } else {
                                rewardAdCount = completed
                                rewardMessage =
                                    "${3 - completed} ad${if (3 - completed == 1) "" else "s"} left"
                            }
                        }

                        is ApiClient.ApiResult.Failure -> {
                            rewardMessage = result.message

                            // The server is authoritative. Do not locally
                            // advance the mission when the claim failed.
                            rewardAdCount = completed - 1
                        }
                    }

                    rewardBusy = false
                }
            },
            onAdClosed = {
                rewardBusy = false
            },
            onAdFailedToShow = {
                rewardBusy = false
                rewardMessage = "Ad could not be shown. Please try again."
