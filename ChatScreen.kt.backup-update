private fun cleanNovaraText(raw: String): String {

    return raw
        .replace(
            Regex("(?m)^\\s*#{1,6}\\s*"),
            ""
        )
        .replace(
            "**",
            ""
        )
        .replace(
            Regex("(?m)^\\s*\\*\\s+"),
            "• "
        )
        .replace(
            Regex("(?m)^\\s*-\\s+"),
            "• "
        )
        .replace(
            Regex("(?m)^\\s*_{3,}\\s*$"),
            ""
        )
        .replace(
            Regex("(?m)^[*#]+\\s*$"),
            ""
        )
        .trim()
}

