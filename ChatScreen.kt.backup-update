@Composable
private fun NovaraThinkingIndicator(showText: Boolean) {
    val transition = rememberInfiniteTransition(label = "novara_thinking")

    val rotation by transition.animateFloat(
        initialValue = 0f,
        targetValue = 360f,
        animationSpec = infiniteRepeatable(
            animation = tween(
                durationMillis = 2600,
                easing = LinearEasing
            )
        ),
        label = "rotation"
    )

    val alpha by transition.animateFloat(
        initialValue = 0.55f,
        targetValue = 1f,
        animationSpec = infiniteRepeatable(
            animation = tween(900),
            repeatMode = RepeatMode.Reverse
        ),
        label = "pulse"
    )

    Row(
        modifier = Modifier
            .fillMaxWidth()
            .padding(
                horizontal = 12.dp,
                vertical = 10.dp
            ),
        verticalAlignment = Alignment.CenterVertically
    ) {
        Image(
            painter = painterResource(R.drawable.novara_logo),
            contentDescription = "Novara",
            modifier = Modifier
                .size(34.dp)
                .rotate(rotation)
                .alpha(alpha)
        )

        if (showText) {
            Spacer(Modifier.width(10.dp))

            Text(
                "Novara is thinking…",
                style = MaterialTheme.typography.bodyMedium,
                fontWeight = FontWeight.Medium
            )
        }
    }
}

