    fun newChat() {
        currentConversation = null
        messages = emptyList()
        input = ""
        error = null
    }

    fun send() {

        val text =
            input.trim()

        if (
            (text.isEmpty() && selectedFile == null) ||
            loading
        ) return

        val attachmentToSend = selectedFile

        input = ""
        loading = true
        showThinkingText = false
        error = null
        selectedFile = null
        selectedFileName = null

        messages =
            messages +
                ApiClient.ChatMessage(
                    id = java.util.UUID.randomUUID().toString(),
                    role = "user",
                    text = text,
                    attachmentPath = attachmentToSend?.absolutePath,
                    attachmentType = attachmentToSend?.extension?.lowercase()
                )

        sendJob = scope.launch {

            when (
                val result =
                    ApiClient.sendMessage(
                        text = text,
                        conversationId =
                            currentConversation,
                        model = modelId,
                        webSearch = webSearch,
                        imageGeneration = imageGen,
                        attachment = attachmentToSend
                    )
            ) {

                is ApiClient.ApiResult.Success -> {

                    currentConversation =
                        result.data.conversationId

                    val cleanReply =
                        cleanNovaraText(
                            result.data.reply
                        )

                    messages =
                        messages +
                            ApiClient.ChatMessage(
                                id =
                                    result.data.messageId,
                                role = "assistant",
                                text =
                                    cleanReply,
                                attachmentPath =
                                    result.data.generatedImage,
                                attachmentType =
                                    if (
                                        result.data
                                            .generatedImage != null
                                    )
                                        "image"
                                    else
                                        null
                            )

                    if (voiceEnabled && voiceModeActive && cleanReply.isNotBlank()) {
                        voiceSpeaking = true
                        speakText(context, cleanReply, selectedVoiceProfile, onDone = {
                            voiceSpeaking = false
                            if (voiceModeActive) {
                                voiceRestartRequested = true
                            }
                        })
                    } else if (voiceModeActive) {
                        voiceRestartRequested = true
                    }
                }

                is ApiClient.ApiResult.Failure ->
                    error = result.message
            }

            loading = false
            showThinkingText = false
            sendJob = null
            if (voiceRestartRequested && voiceModeActive && !voiceMuted) {
                voiceRestartRequested = false
                voiceRestartTick++
            }

            when (
                val result =
                    ApiClient.getConversations()
            ) {
                is ApiClient.ApiResult.Success ->
                    conversations =
                        result.data

                else -> Unit
            }
        }
    }

