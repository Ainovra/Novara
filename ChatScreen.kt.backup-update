                    val mimeType = resolver.getType(uri) ?: "application/octet-stream"

                    val extensionFromName = originalName
                        ?.substringAfterLast(".", "")
                        ?.lowercase()
                        ?.takeIf { it.isNotBlank() && it != originalName.lowercase() }

                    val extensionFromMime = when {
                        mimeType.equals("image/jpeg", true) -> "jpg"
                        mimeType.equals("image/png", true) -> "png"
                        mimeType.equals("image/webp", true) -> "webp"
                        mimeType.equals("image/gif", true) -> "gif"
                        mimeType.equals("image/bmp", true) -> "bmp"
                        mimeType.equals("image/heic", true) -> "heic"
                        mimeType.equals("video/mp4", true) -> "mp4"
                        mimeType.equals("video/quicktime", true) -> "mov"
                        mimeType.equals("video/webm", true) -> "webm"
                        mimeType.equals("video/x-matroska", true) -> "mkv"
                        mimeType.equals("video/x-msvideo", true) -> "avi"
                        else -> null
                    }

                    val extension = extensionFromName ?: extensionFromMime ?: "bin"
                    val displayName = originalName ?: "media_${System.currentTimeMillis()}.$extension"
                    val safeCacheName = "media_${System.currentTimeMillis()}.$extension"
                    val destFile = java.io.File(context.cacheDir, safeCacheName)

                    resolver.openInputStream(uri)?.use { input ->
