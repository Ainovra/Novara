private fun formatNovaraResponse(text: String): String {
    return text
        .replace(Regex("(?m)^\\s*#{1,6}\\s*"), "")
        .replace(Regex("(?m)^\\s*[-*]\\s+"), "• ")
        .replace(Regex("\\n{3,}"), "\n\n")
        .trim()
}

@Composable
private fun MessageBubble(
    message: ApiClient.ChatMessage,
    onCopy: () -> Unit,
    onSpeak: () -> Unit,
    onFeedback: (Int) -> Unit
) {
    val isUser = message.role == "user"
    val attachmentPath = message.attachmentPath
    val attachmentFile = attachmentPath?.let { java.io.File(it) }
    val attachmentExt = attachmentFile?.extension?.lowercase() ?: ""

    val imageExts = setOf("jpg", "jpeg", "png", "webp", "gif", "bmp", "heic")
    val videoExts = setOf("mp4", "mov", "webm", "mkv", "avi")

    Column(
        modifier = Modifier
            .fillMaxWidth()
            .padding(vertical = 6.dp),
        horizontalAlignment = if (isUser) Alignment.End else Alignment.Start
    ) {
        Text(
            text = if (isUser) "You" else "Novara",
            style = MaterialTheme.typography.labelMedium,
            color = MaterialTheme.colorScheme.onSurfaceVariant,
            modifier = Modifier.padding(horizontal = 4.dp, vertical = 2.dp)
        )

        Surface(
            modifier = Modifier
                .padding(top = 4.dp)
                .fillMaxWidth(if (isUser) 0.86f else 1f),
            shape = RoundedCornerShape(18.dp),
            color = if (isUser)
                MaterialTheme.colorScheme.primary.copy(alpha = 0.14f)
            else
                MaterialTheme.colorScheme.surfaceVariant,
            tonalElevation = if (isUser) 0.dp else 1.dp,
            shadowElevation = 1.dp
        ) {
            Column(
                modifier = Modifier.padding(10.dp),
                verticalArrangement = Arrangement.spacedBy(8.dp)
            ) {

                /*
                 * CHATGPT-STYLE ATTACHMENT PREVIEW
                 */
                if (attachmentFile != null && attachmentFile.exists()) {

                    when {
                        attachmentExt in imageExts -> {
                            val bitmap = remember(attachmentFile.absolutePath) {
                                BitmapFactory.decodeFile(attachmentFile.absolutePath)
                            }

                            if (bitmap != null) {
                                Surface(
                                    modifier = Modifier
                                        .fillMaxWidth()
                                        .clip(RoundedCornerShape(14.dp)),
                                    shape = RoundedCornerShape(14.dp),
                                    tonalElevation = 1.dp
                                ) {
                                    Image(
                                        bitmap = bitmap.asImageBitmap(),
                                        contentDescription = attachmentFile.name,
                                        modifier = Modifier
                                            .fillMaxWidth()
                                            .heightIn(max = 360.dp),
                                        contentScale = ContentScale.Crop
                                    )
                                }
                            }
                        }

                        attachmentExt in videoExts -> {
                            val thumbnail = remember(attachmentFile.absolutePath) {
                                try {
                                    val retriever = MediaMetadataRetriever()
                                    retriever.setDataSource(attachmentFile.absolutePath)
                                    val frame = retriever.getFrameAtTime(
                                        0L,
                                        MediaMetadataRetriever.OPTION_CLOSEST_SYNC
                                    )
                                    retriever.release()
                                    frame
                                } catch (_: Exception) {
                                    null
                                }
                            }

                            Surface(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .heightIn(min = 150.dp, max = 300.dp),
                                shape = RoundedCornerShape(14.dp),
                                tonalElevation = 2.dp
                            ) {
                                Box(
                                    modifier = Modifier.fillMaxSize(),
                                    contentAlignment = Alignment.Center
                                ) {
                                    if (thumbnail != null) {
                                        Image(
                                            bitmap = thumbnail.asImageBitmap(),
                                            contentDescription = attachmentFile.name,
                                            modifier = Modifier.fillMaxSize(),
                                            contentScale = ContentScale.Crop
                                        )
                                    }

                                    Surface(
                                        shape = CircleShape,
                                        color = MaterialTheme.colorScheme.surface.copy(alpha = 0.92f)
                                    ) {
                                        Icon(
                                            Icons.Default.PlayArrow,
                                            contentDescription = "Play video",
                                            modifier = Modifier
                                                .padding(12.dp)
                                                .size(30.dp)
                                        )
                                    }
                                }
                            }
                        }

                        else -> {
                            val isPdf = attachmentExt == "pdf"
                            val isDoc = attachmentExt == "docx"
                            val isSheet = attachmentExt == "xlsx"
                            val isPresentation = attachmentExt == "pptx"
                            val isText = attachmentExt in setOf("txt", "csv", "json")

                            val icon = when {
                                isPdf -> Icons.Default.PictureAsPdf
                                isDoc -> Icons.Default.Description
                                isSheet -> Icons.Default.TableChart
                                isPresentation -> Icons.Default.Slideshow
                                isText -> Icons.Default.TextSnippet
                                else -> Icons.Default.InsertDriveFile
                            }

                            Surface(
                                modifier = Modifier.fillMaxWidth(),
                                shape = RoundedCornerShape(14.dp),
                                tonalElevation = 2.dp
                            ) {
                                Row(
                                    modifier = Modifier.padding(14.dp),
                                    verticalAlignment = Alignment.CenterVertically
                                ) {
                                    Surface(
                                        shape = RoundedCornerShape(10.dp),
                                        color = MaterialTheme.colorScheme.primary.copy(alpha = 0.12f)
                                    ) {
                                        Icon(
                                            imageVector = icon,
                                            contentDescription = "Attachment",
                                            modifier = Modifier
                                                .padding(11.dp)
                                                .size(30.dp),
                                            tint = MaterialTheme.colorScheme.primary
                                        )
                                    }

                                    Spacer(Modifier.width(12.dp))

                                    Column(
                                        modifier = Modifier.weight(1f)
                                    ) {
                                        Text(
                                            text = attachmentFile.name,
                                            maxLines = 2,
                                            overflow = androidx.compose.ui.text.style.TextOverflow.Ellipsis,
                                            fontSize = 14.sp,
                                            fontWeight = FontWeight.Medium
                                        )

                                        Spacer(Modifier.height(3.dp))

                                        Text(
                                            text = when {
                                                isPdf -> "PDF document"
                                                isDoc -> "Word document"
                                                isSheet -> "Excel spreadsheet"
                                                isPresentation -> "PowerPoint presentation"
                                                attachmentExt == "csv" -> "CSV file"
                                                attachmentExt == "json" -> "JSON file"
                                                attachmentExt == "txt" -> "Text file"
                                                else -> attachmentExt.uppercase().ifBlank { "FILE" }
                                            },
                                            fontSize = 12.sp,
                                            color = MaterialTheme.colorScheme.onSurfaceVariant
                                        )
                                    }
                                }
                            }
                        }
                    }

                    // Filename row for media, matching modern chat attachment UI.
                    if (attachmentExt in imageExts || attachmentExt in videoExts) {
                        Row(
                            modifier = Modifier
                                .fillMaxWidth()
                                .padding(horizontal = 2.dp),
                            verticalAlignment = Alignment.CenterVertically
                        ) {
                            Icon(
                                imageVector = if (attachmentExt in videoExts)
                                    Icons.Default.Videocam
                                else
                                    Icons.Default.Image,
                                contentDescription = null,
                                modifier = Modifier.size(16.dp),
                                tint = MaterialTheme.colorScheme.onSurfaceVariant
                            )

                            Spacer(Modifier.width(6.dp))

                            Text(
                                text = attachmentFile.name,
                                maxLines = 1,
                                overflow = androidx.compose.ui.text.style.TextOverflow.Ellipsis,
                                fontSize = 12.sp,
                                color = MaterialTheme.colorScheme.onSurfaceVariant,
                                modifier = Modifier.weight(1f)
                            )
                        }
                    }
                }

                if (message.text.isNotBlank()) {
                    Text(
                        text = if (message.role == "assistant")
                            cleanNovaraText(message.text)
                        else
                            message.text,
                        modifier = Modifier.padding(
                            horizontal = 6.dp,
                            vertical = 4.dp
                        ),
                        fontSize = 15.5.sp,
                        lineHeight = 22.sp,
                        color = MaterialTheme.colorScheme.onSurface
                    )
                }
            }
        }

        if (message.role == "assistant") {
            Row(
                modifier = Modifier.padding(top = 2.dp),
                horizontalArrangement = Arrangement.spacedBy(2.dp)
            ) {
                IconButton(
                    onClick = onCopy,
                    modifier = Modifier.size(34.dp)
                ) {
                    Icon(
                        Icons.Default.ContentCopy,
                        contentDescription = "Copy",
                        modifier = Modifier.size(17.dp),
                        tint = MaterialTheme.colorScheme.onSurfaceVariant
                    )
                }

                IconButton(
                    onClick = onSpeak,
                    modifier = Modifier.size(34.dp)
                ) {
                    Icon(
                        Icons.Default.VolumeUp,
                        contentDescription = "Speak",
                        modifier = Modifier.size(17.dp),
                        tint = MaterialTheme.colorScheme.onSurfaceVariant
                    )
                }
            }
        }
    }
}


private fun speakText(
    context: Context,
    text: String,
    profile: VoiceProfile,
    onDone: (() -> Unit)? = null
) {
    if (text.isBlank()) {
        onDone?.invoke()
        return
    }

    val existing = novaraTts
    if (existing != null) {
        speakWithTts(existing, text, profile, onDone)
        return
    }

    novaraTts =
        TextToSpeech(context.applicationContext) { status ->
            if (status == TextToSpeech.SUCCESS) {
                novaraTts?.let {
                    speakWithTts(it, text, profile, onDone)
                }
            } else {
                onDone?.invoke()
            }
        }
}

private fun speakWithTts(
    speaker: TextToSpeech,
    text: String,
    profile: VoiceProfile,
    onDone: (() -> Unit)? = null
) {
    val locale = Locale.getDefault()
    val available = speaker.isLanguageAvailable(locale)
    speaker.language =
        if (available >= TextToSpeech.LANG_AVAILABLE) locale else Locale.getDefault()

    // Keep profiles natural: small pitch/rate changes rather than cartoonish effects.
    speaker.setPitch(profile.pitch)
    speaker.setSpeechRate(profile.rate)

    // Prefer a matching installed system voice when one is available.
    val candidates = speaker.voices
        ?.filter {
            val vLocale = it.locale
            vLocale.language == speaker.language.language
        }
        ?.sortedBy { it.name }
        ?: emptyList()

    if (candidates.isNotEmpty()) {
        val index = NOVARA_VOICE_PROFILES.indexOfFirst { it.id == profile.id }
        speaker.voice = candidates[index.coerceIn(0, candidates.lastIndex)]
    }

    val utteranceId = "novara_reply_${System.currentTimeMillis()}"

    if (onDone != null) {
        speaker.setOnUtteranceProgressListener(
            object : android.speech.tts.UtteranceProgressListener() {
                override fun onStart(utteranceId: String?) = Unit

                override fun onDone(utteranceId: String?) {
                    onDone.invoke()
                }

                @Deprecated("Deprecated in Java")
                override fun onError(utteranceId: String?) {
                    onDone.invoke()
                }
            }
        )
    }

    speaker.speak(
        text,
        TextToSpeech.QUEUE_FLUSH,
        null,
        utteranceId
    )
}

private fun stopNovaraTts() {
    novaraTts?.stop()
    novaraTts?.shutdown()
    novaraTts = null
}
