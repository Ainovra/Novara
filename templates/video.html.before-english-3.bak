<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Novara — Video Studio</title>
<link rel="stylesheet" href="/static/style.css">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand">
      <span class="brand-mark-sm">Novara</span>
    </div>
    <a href="/app" class="new-chat-btn" style="text-decoration:none; display:flex; justify-content:center;">← Back to Chat</a>
    <div class="sidebar-footer">
      <div class="user-row">
        <div class="avatar">{{ username[0]|upper if username else "N" }}</div>
        <span class="username-label">{{ username }}</span>
      </div>
      <a href="/logout" class="icon-btn logout-btn" title="Logout">⏻</a>
    </div>
  </aside>

  <main class="main">
    <header class="topbar" style="display:flex;">
      <span class="topbar-title">Video Studio</span>
    </header>

    {% if not video_enabled %}
    <div class="video-notice">
      Video generation/editing abhi kisi provider se connect nahi hai. README ke "Video generation" section mein
      <code>VIDEO_API_URL</code> aur <code>VIDEO_API_KEY</code> to learn how to configure them — until that is done,
      this screen will be visible, but videos cannot actually be generated.
    </div>
    {% endif %}

    <div class="video-studio">
      <div class="video-card">
        <h3>Video Generation</h3>
        <p class="muted-text">Create a video from text.</p>
        <textarea id="videoPrompt" class="video-prompt" placeholder="Describe the video you want to create…"></textarea>
        <div class="video-options">
          <select id="videoRatio">
            <option value="16:9">16:9 — Landscape</option>
            <option value="9:16">9:16 — Reels/Shorts</option>
            <option value="1:1">1:1 — Square</option>
          </select>
          <select id="videoDuration">
            <option value="5">5 seconds</option>
            <option value="10">10 seconds</option>
            <option value="15">15 seconds</option>
          </select>
        </div>
        <button class="auth-btn" id="generateBtn">Generate Video</button>
        <div id="videoGenStatus" class="video-status"></div>
      </div>

      <div class="video-card">
        <h3>Video Editing</h3>
        <p class="muted-text">Upload a video to trim it, add captions, or enhance it with AI.</p>
        <div class="upload-drop" id="uploadDrop">
          <span>📁 Click to upload a video</span>
          <input type="file" id="videoFileInput" accept="video/*" hidden>
        </div>
        <video id="videoPreview" class="video-preview" style="display:none;" controls></video>
        <div class="video-options">
          <button class="icon-btn video-action-btn" data-action="trim">Trim</button>
          <button class="icon-btn video-action-btn" data-action="caption">Add Caption</button>
          <button class="icon-btn video-action-btn" data-action="enhance">AI Enhance</button>
        </div>
        <div id="videoEditStatus" class="video-status"></div>
      </div>
    </div>
  </main>
</div>

<script>
document.getElementById("generateBtn").onclick = async () => {
  const prompt = document.getElementById("videoPrompt").value.trim();
  const statusBox = document.getElementById("videoGenStatus");
  if (!prompt) { statusBox.textContent = "Please enter a video description first."; return; }

  statusBox.textContent = "Generating…";
  try {
    const res = await fetch("/api/video/generate", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        prompt,
        aspect_ratio: document.getElementById("videoRatio").value,
        duration: document.getElementById("videoDuration").value
      })
    });
    const data = await res.json();
    statusBox.textContent = data.error ? data.error : "Video generated ✅";
  } catch (e) {
    statusBox.textContent = "Something went wrong. Please try again.";
  }
};

const uploadDrop = document.getElementById("uploadDrop");
const videoFileInput = document.getElementById("videoFileInput");
const videoPreview = document.getElementById("videoPreview");

uploadDrop.onclick = () => videoFileInput.click();
videoFileInput.onchange = () => {
  const file = videoFileInput.files[0];
  if (!file) return;
  videoPreview.src = URL.createObjectURL(file);
  videoPreview.style.display = "block";
};

document.querySelectorAll(".video-action-btn").forEach(btn => {
  btn.onclick = async () => {
    const statusBox = document.getElementById("videoEditStatus");
    const file = videoFileInput.files[0];
    if (!file) { statusBox.textContent = "Please upload a video first."; return; }

    const fd = new FormData();
    fd.append("file", file);
    fd.append("action", btn.dataset.action);
    statusBox.textContent = "Processing…";
    try {
      const res = await fetch("/api/video/edit", { method: "POST", body: fd });
      const data = await res.json();
      statusBox.textContent = data.error ? data.error : "Done ✅";
    } catch (e) {
      statusBox.textContent = "Something went wrong. Please try again.";
    }
  };
});
</script>
</body>
</html>
