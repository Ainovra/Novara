class MainActivity : ComponentActivity() {

    private var authError by mutableStateOf<String?>(null)

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        handleIntent(intent)

        setContent {
            NovaraTheme {
                Surface(
                    modifier = Modifier.fillMaxSize(),
                    color = NovaraBg
                ) {
                    NovaraNativeApp(
                        onGoogleLogin = {
                            openGoogleLogin()
                        },
                        onAuthCode = { code ->
                            consumeAuthCode(code)
                        }
                    )
                }
            }
        }
    }

    override fun onNewIntent(intent: Intent) {
        super.onNewIntent(intent)
        setIntent(intent)
        handleIntent(intent)
    }

    private fun handleIntent(intent: Intent?) {
        val data = intent?.data ?: return

        if (
            data.scheme == Config.AUTH_HANDOFF_SCHEME &&
            data.host == Config.AUTH_HANDOFF_HOST
        ) {
            val code = data.getQueryParameter("code") ?: return
            consumeAuthCode(code)
        }
    }

    private fun consumeAuthCode(code: String) {
        lifecycleScope.launch {
            when (val result = ApiClient.consumeAuthCode(code)) {
                is ApiClient.ApiResult.Success -> {
                    authError = null
                }

                is ApiClient.ApiResult.Failure -> {
                    authError = result.message
                }
            }
        }
    }

    private fun openGoogleLogin() {
        val url =
            Config.WEB_BASE_URL.trimEnd('/') +
                    Config.GOOGLE_LOGIN_PATH

        startActivity(
            Intent(
                Intent.ACTION_VIEW,
                Uri.parse(url)
            )
        )
    }
}

@Composable
private fun NovaraNativeApp(
    onGoogleLogin: () -> Unit,
    onAuthCode: (String) -> Unit
) {
    val context = LocalContext.current
    val prefs =
        context.getSharedPreferences(
            "novara_native",
            android.content.Context.MODE_PRIVATE
        )

    var onboardingDone by remember {
        mutableStateOf(
            prefs.getBoolean("onboarding_done", false)
        )
    }

    var termsDone by remember {
        mutableStateOf(
            prefs.getBoolean("terms_done", false)
        )
    }

    var loggedIn by remember {
        mutableStateOf(
            prefs.getBoolean("logged_in", false)
        )
    }

    var onboardingPage by remember {
        mutableIntStateOf(0)
    }

    var showNovaraSplash by remember {
        mutableStateOf(false)
    }

    when {
        !onboardingDone -> {
            OnboardingScreen(
                page = onboardingPage,
                onNext = {
                    if (onboardingPage < 4) {
                        onboardingPage++
                    } else {
                        prefs.edit()
                            .putBoolean("onboarding_done", true)
                            .apply()
                        onboardingDone = true
                    }
                },
                onSkip = {
                    prefs.edit()
                        .putBoolean("onboarding_done", true)
                        .apply()
                    onboardingDone = true
                }
            )
        }

        !termsDone -> {
            TermsScreenNative(
                onContinue = {
                    prefs.edit()
                        .putBoolean("terms_done", true)
                        .apply()
                    termsDone = true
                }
            )
        }

        !loggedIn -> {
            LoginScreenNative(
                onGoogle = {
                    onGoogleLogin()
                },
                onEmail = {
                    // Email flow can be connected to the existing backend next.
                },
                onGuest = {
                    prefs.edit()
                        .putBoolean("logged_in", true)
                        .apply()
                    loggedIn = true
                    showNovaraSplash = true
                }
            )
        }

        else -> {
            if (showNovaraSplash) {
                NovaraLogoSplash(
                    onFinished = {
                        showNovaraSplash = false
                    }
                )
            } else {
                com.novara.app.ui.screens.ChatScreen()
            }
        }
    }
}

@Composable
private fun OnboardingScreen(
    page: Int,
    onNext: () -> Unit,
    onSkip: () -> Unit
) {
    val slides = listOf(
        Triple(
            "✦",
            "Novara",
            "Your personal AI assistant — chat, learn, and get things done."
        ),
        Triple(
            "💬",
            "Every conversation is saved",
            "Separate conversations are kept in your history — pick up any of them, anytime."
        ),
        Triple(
            "⌕",
            "Photos, PDFs, and more",
            "Send an image and Novara can “see” it. Attach a PDF and ask questions about it."
        ),
        Triple(
            "🎙",
            "Speak instead of typing",
            "Tap the mic and talk — your voice turns into text instantly."
        ),
        Triple(
            "⚡",
            "Ready when you are",
            "Ask anything — text, photo, PDF, voice, or ask Novara to create an image."
        )
    )

    val slide = slides[page]

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(
                Brush.verticalGradient(
                    listOf(
                        Color(0xFF071018),
                        Color(0xFF091823),
                        Color(0xFF050B10)
                    )
                )
            )
    ) {
        Text(
            text = "Skip",
            color = NovaraMuted,
            fontSize = 15.sp,
            modifier = Modifier
                .align(Alignment.TopEnd)
                .padding(top = 52.dp, end = 24.dp)
                .clickable { onSkip() }
        )

        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(horizontal = 30.dp),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.Center
        ) {

            Box(
                modifier = Modifier
                    .size(72.dp)
                    .clip(RoundedCornerShape(22.dp))
                    .background(
                        Brush.linearGradient(
                            listOf(
                                Color(0xFF101E43),
                                Color(0xFF08182A)
                            )
                        )
                    )
                    .border(
                        1.dp,
                        Color(0xFF244A67),
                        RoundedCornerShape(22.dp)
                    ),
                contentAlignment = Alignment.Center
            ) {
                Text(
                    text = slide.first,
                    fontSize = 34.sp,
                    color = Color.White
                )
            }

            Spacer(Modifier.height(26.dp))

            Text(
                text = slide.second,
                color = NovaraText,
                fontSize = 29.sp,
                fontWeight = FontWeight.Bold
            )

            Spacer(Modifier.height(14.dp))

            Text(
                text = slide.third,
                color = NovaraText,
                fontSize = 17.sp,
                lineHeight = 25.sp,
                modifier = Modifier.widthIn(max = 350.dp)
            )

            Spacer(Modifier.height(38.dp))

            Row(
                horizontalArrangement = Arrangement.spacedBy(7.dp)
            ) {
                repeat(slides.size) { index ->
                    Box(
                        modifier = Modifier
                            .height(7.dp)
                            .width(
                                if (index == page) 25.dp
                                else 7.dp
                            )
                            .clip(CircleShape)
                            .background(
                                if (index == page)
                                    NovaraYellow
                                else
                                    Color(0xFF56636C)
                            )
                    )
                }
            }

            Spacer(Modifier.height(28.dp))

            Button(
                onClick = onNext,
                modifier = Modifier
                    .width(150.dp)
                    .height(54.dp),
                shape = RoundedCornerShape(16.dp),
                colors = ButtonDefaults.buttonColors(
                    containerColor = NovaraYellow,
                    contentColor = Color(0xFF302500)
                )
            ) {
                Text(
                    if (page == slides.lastIndex)
                        "Get Started"
                    else
                        "Next",
                    fontSize = 16.sp,
                    fontWeight = FontWeight.Medium
                )
            }
        }
    }
}

